# Supabase — projet la-dogosphere (eu-central-2, Zurich)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Connexion directe Postgres, utilisee par les scripts de sauvegarde
SUPABASE_DB_URL=

# URL publique du site, utilisee dans les emails et les liens de paiement.
# Sert de base aux images des emails : elle doit repondre en HTTPS avec un
# certificat valide. Valeur actuelle : https://reservation.ladogosphere.ch
# A basculer sur https://ladogosphere.ch une fois ce domaine configure.
NEXT_PUBLIC_SITE_URL=

# Envoi d'emails transactionnels
RESEND_API_KEY=

# Secret partage protegeant les routes /api/cron
CRON_SECRET=
